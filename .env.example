# Pocket ID Instance URL (e.g., https://auth.example.com)
POCKET_ID_URL=

# Pocket ID API Key (for fetching app list)
POCKET_ID_API_KEY=

# OIDC Configuration for this Launcher
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Secret used to sign session cookies (generate a random string)
AUTH_SECRET=

# Public URL of this launcher (for callbacks)
PUBLIC_APP_URL=http://localhost:5173

# Customization
PUBLIC_LAUNCHER_TITLE="Family App Launcher"
PUBLIC_LAUNCHER_DESCRIPTION="Welcome! Access your shared services below."
# Optional: Theme-specific logos
CUSTOM_LOGO_DARK=
CUSTOM_LOGO_LIGHT=
# Optional: Background image URL
PUBLIC_BG_IMAGE_URL=
